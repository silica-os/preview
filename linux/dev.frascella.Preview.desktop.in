[Desktop Entry]
Type=Application
Name=Preview
Name[it]=Anteprima
GenericName=Image and PDF Viewer
GenericName[it]=Visore di immagini e PDF
Comment=View images and PDF documents
Comment[it]=Visualizza immagini e documenti PDF
Exec=@EMBEDDER@ --size 900x700 --title Preview --app-id dev.frascella.Preview @BUNDLE@ %F
Icon=image-x-generic
X-Silica-Icon=photo-viewer
StartupWMClass=dev.frascella.Preview
MimeType=image/png;image/jpeg;image/gif;image/tiff;image/webp;image/bmp;image/svg+xml;application/pdf;
Categories=Graphics;Viewer;Office;
Keywords=image;picture;photo;pdf;viewer;
Keywords[it]=immagine;foto;pdf;visore;
Terminal=false
OnlyShowIn=Silica;
